        "value": "fim"
      },
      {
        "field": "event.action",
        "value": "new"
      }
    ]
  },
  {
    "value": "FIM: {file.path} modified",
    "conditions": [
      {
        "field": "file.path"
      },
      {
        "field": "event.dataset",
        "value": "fim"
      },
      {
        "field": "event.action",
        "value": "change"
      }
    ]
  },
  {
    "value": "FIM: {nxlog.fim.previous.path} renamed to {file.path}",
